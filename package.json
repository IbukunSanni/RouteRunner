{
  "name": "routerunner-fullstack",
  "version": "1.5.0",
  "description": "RouteRunner - Full Stack Application",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend/ApiRunner && dotnet run",
    "frontend": "cd frontend && npm run dev",
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "cd backend/ApiRunner && dotnet build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "cd frontend && npm install",
    "clean": "concurrently \"npm run clean:backend\" \"npm run clean:frontend\"",
    "clean:backend": "cd backend/ApiRunner && dotnet clean",
    "clean:frontend": "cd frontend && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "api",
    "frontend",
    "backend",
    "dotnet",
    "react",
    "vite"
  ]
}